    - target: {fileID: 7269181773766021857, guid: 0279a5ab4fa3243f893e45b3e7d7ce5d, type: 3}
      propertyPath: m_text
      value: "Udsnit af Resens kort over K\xF8benhavn fra 1674, som viser forskellen
