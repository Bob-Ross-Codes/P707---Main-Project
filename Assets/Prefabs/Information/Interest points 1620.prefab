    m_Modifications:
    - target: {fileID: 237826017943210953, guid: 0279a5ab4fa3243f893e45b3e7d7ce5d, type: 3}
      propertyPath: m_text
      value: "Den nye Vesterport er den anden byport mod vest i byens historie. Den
        l\xE5 l\xE6ngere mod vest end den f\xF8rste byport, der stadig stod. Der
        er kun begr\xE6nsede beskrivelser af den nye port i skriftlige kilder, og
        der findes ingen illustrationer. Ud fra beskrivelser og fund fra udgravninger
        har vi sammensat et bud p\xE5, hvordan porten kan have set ud i 1620."
      objectReference: {fileID: 0}
    - target: {fileID: 311113509142722892, guid: 0279a5ab4fa3243f893e45b3e7d7ce5d, type: 3}
