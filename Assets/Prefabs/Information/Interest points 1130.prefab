    - target: {fileID: 197956369606419583, guid: e20b6cb1294a047f4b8fb29f4fbe2f13, type: 3}
      propertyPath: caption
      value: "Smal gr\xF8ft fra bj\xE6lke fra et hus, set til venstre for landm\xE5lerstokken.
        Aftrykket blev fundet netop her under de store metro-udgravninger i 2011.
        Foto: K\xF8benhavns Museum."
      objectReference: {fileID: 0}
