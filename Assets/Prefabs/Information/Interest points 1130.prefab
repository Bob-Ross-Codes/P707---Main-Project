--- !u!1001 &5154164963266021380
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 900269832908634810}
    m_Modifications:
    - target: {fileID: 197956369606419583, guid: e20b6cb1294a047f4b8fb29f4fbe2f13, type: 3}
      propertyPath: body
      value: "Kun en lille del af kirkeg\xE5rden er unders\xF8gt. Der ligger nok
        flere grave af de \xE6ldste k\xF8benhavnere bare en lille meter under nutidens
        vejbel\xE6gning uden for de arealer, der har skullet bruges til anl\xE6gsarbejde.
        Der var b\xE5de kvinder, m\xE6nd og b\xF8rn begravet her, og kulstof 14-dateringer
        af skeletterne viser, at de var blevet begravet mellem ca. 1026 og 1155.
        Gravene l\xE5 derfor ogs\xE5 i flere niveauer og var gravet ned delvist oven
        i hinanden. Gravene i middelalderen l\xE5 generelt, s\xE5 de pegede i samme
        retning som kirken, \xF8st-vest. P\xE5 R\xE5dhuspladsen l\xE5 gravene med
        lidt forskellig retning, og det viser, at de anlagte grave kan have forholdt
        sig til to versioner af kirken. F\xF8r \xE5r 1200 blev folk ikke begravet
        inde i selve kirkebygningen, medmindre det var bisper eller kongelige. N\xE5r
        der er et omr\xE5de uden grave p\xE5 kirkeg\xE5rden, kan det derfor vise,
        hvor kirken har st\xE5et."
      objectReference: {fileID: 0}
    - target: {fileID: 197956369606419583, guid: e20b6cb1294a047f4b8fb29f4fbe2f13, type: 3}
      propertyPath: photo
      value: 
      objectReference: {fileID: 2800000, guid: 8c1691e5780244f07a288c58649c593c, type: 3}
    - target: {fileID: 197956369606419583, guid: e20b6cb1294a047f4b8fb29f4fbe2f13, type: 3}
      propertyPath: title
      value: "Kirkeg\xE5rden"
      objectReference: {fileID: 0}
    - target: {fileID: 197956369606419583, guid: e20b6cb1294a047f4b8fb29f4fbe2f13, type: 3}
      propertyPath: caption
      value: "Flere grave fra kirkeg\xE5rden p\xE5 R\xE5dhuspladsen. Gravene er her
        t\xF8mt for jord og skeletter og fremst\xE5r som de nedgravninger, man lagde
        kister og de d\xF8de i."
      objectReference: {fileID: 0}
    - target: {fileID: 375352395081321327, guid: e20b6cb1294a047f4b8fb29f4fbe2f13, type: 3}
